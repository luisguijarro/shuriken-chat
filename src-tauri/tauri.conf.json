{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shuriken Chat",
  "mainBinaryName": "shuriken-chat",
  "version": "0.1.0",
  "identifier": "dev.shurikenchat.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "category": "Utility",
    "shortDescription": "Chat de Social Stream Ninja flotando en tu escritorio",
    "longDescription": "Ventana sin bordes, transparente y redimensionable que muestra el chat unificado de Social Stream Ninja en el escritorio.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
